---
import EpisodeBackground from "../components/EpisodeBackground.astro";
import EpisodeHero from "../components/EpisodeHero.astro";
import EpisodeRail from "../components/EpisodeRail.astro";
import SeriesHeader from "../components/SeriesHeader.astro";
import WatchDialog from "../components/WatchDialog.astro";
import { getEpisodePath, publishedEpisodes, type Episode } from "../data/episodes";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  episode: Episode;
}

const { episode } = Astro.props;
const isHomepage = episode.slug === "introduction";
const siteUrl = new URL("/", Astro.site).href;
const canonicalUrl = new URL(getEpisodePath(episode), Astro.site);
const imageUrl = new URL(episode.posterImage, Astro.site);
const title = episode.seoTitle;
const description = episode.seoDescription;
const imageAlt = isHomepage
  ? "Build Connected — conversations behind connected products"
  : `${episode.companyName} in ${episode.episodeNumber} of Build Connected`;
const organizationId = "https://1ot.com/#organization";
const websiteId = `${siteUrl}#website`;
const webpageId = `${canonicalUrl.href}#webpage`;
const videoIsReady = Boolean(episode.youtubeId && episode.videoAvailable);
const durationMinutes = Number.parseInt(episode.duration, 10);

const organizationStructuredData = {
  "@type": "Organization",
  "@id": organizationId,
  name: "1oT",
  url: "https://1ot.com/",
};

const websiteStructuredData = {
  "@type": "WebSite",
  "@id": websiteId,
  url: siteUrl,
  name: "Build Connected",
  alternateName: ["Build Connected by 1oT", "build.1ot.com"],
  description: "Conversations behind the connection",
  inLanguage: "en",
  publisher: { "@id": organizationId },
};

const webpageStructuredData = {
  "@type": isHomepage ? "CollectionPage" : "WebPage",
  "@id": webpageId,
  url: canonicalUrl.href,
  name: title,
  description,
  inLanguage: "en",
  isPartOf: { "@id": websiteId },
  publisher: { "@id": organizationId },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: imageUrl.href,
    caption: imageAlt,
  },
  ...(!isHomepage && { datePublished: episode.publicationDateIso }),
};

const videoStructuredData = videoIsReady
  ? {
      "@type": "VideoObject",
      "@id": `${canonicalUrl.href}#video`,
      name: `${episode.companyName}: ${episode.episodeHeadline}`,
      description: episode.shortIntroduction,
      thumbnailUrl: [imageUrl.href],
      uploadDate: episode.publicationDateIso,
      duration: `PT${durationMinutes}M`,
      embedUrl: `https://www.youtube-nocookie.com/embed/${episode.youtubeId}`,
      url: canonicalUrl.href,
      inLanguage: "en",
      publisher: { "@id": organizationId },
      mainEntityOfPage: { "@id": webpageId },
    }
  : null;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    organizationStructuredData,
    ...(isHomepage ? [websiteStructuredData] : []),
    webpageStructuredData,
    ...(videoStructuredData ? [videoStructuredData] : []),
  ],
};

const serializedStructuredData = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en" class="scheme-dark">
  <head>
    <script is:inline>
      (() => {
        const windowWithGtm = window;
        if (windowWithGtm.__buildConnectedGtmLoaded) return;
        windowWithGtm.__buildConnectedGtmLoaded = true;

        windowWithGtm.dataLayer = windowWithGtm.dataLayer || [];
        windowWithGtm.dataLayer.push({
          "gtm.start": new Date().getTime(),
          event: "gtm.js",
        });

        const firstScript = document.getElementsByTagName("script")[0];
        const gtmScript = document.createElement("script");
        gtmScript.async = true;
        gtmScript.src = "https://www.googletagmanager.com/gtm.js?id=GTM-TRCWGKBV";
        firstScript.parentNode.insertBefore(gtmScript, firstScript);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-video-preview:-1" />
    <meta name="theme-color" content="#070908" />
    <meta property="og:type" content={isHomepage ? "website" : "video.other"} />
    <meta property="og:site_name" content="Build Connected" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preload" as="image" href={episode.posterImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={serializedStructuredData}></script>
    <ClientRouter fallback="swap" />
  </head>
  <body transition:animate="none">
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TRCWGKBV"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      ></iframe>
    </noscript>
    <div class="experience" data-experience transition:animate="none">
      <a class="skip-link" href="#main-content">Skip to episode</a>

      <EpisodeBackground episodes={publishedEpisodes} currentEpisode={episode} />
      <div class="cinematic-scrim" aria-hidden="true"></div>

      <SeriesHeader />
      <EpisodeHero episode={episode} />
      <EpisodeRail episodes={publishedEpisodes} currentEpisode={episode} />
    </div>

    {videoIsReady && <WatchDialog episode={episode} />}

    <script id="episode-data" type="application/json" set:html={JSON.stringify(episode)}></script>
    <script src="../scripts/experience.ts"></script>
  </body>
</html>
