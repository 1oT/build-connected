---
import OneOtLogo from "./OneOtLogo.astro";
---

<header class="series-header">
  <div class="series-lockup">
    <a class="brand-link" href="https://1ot.com" aria-label="Visit the 1oT homepage">
      <OneOtLogo />
    </a>
    <span class="series-divider" aria-hidden="true"></span>
    <div class="series-wordmark">
      <span class="series-name">Build Connected</span>
      <span class="series-tagline">Conversations behind the connection</span>
    </div>
  </div>
  <p class="partner-credit">Supported by KPN IoT</p>
</header>
